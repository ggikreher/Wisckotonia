generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DISPUUT
  ADMIN
}

enum BoardRole {
  VOORZITTER
  PENNINGMEESTER
  SECRETARIS
}

enum MemberCategory {
  WISCKO
  LES_WISKO
  MALT_WISCKO
}

enum PointsChoice {
  WHISKY_KRACHTIG
  WHISKY_MEDIUM
  WHISKY_MILD
  WHISKY_VOL
  WHISKY_ARTIKEL
  KORTING_WEEKEND
  KORTING_KLEDING
  DUURDERE_FLES
}

/// Inlogaccount. Staat los van de ledenkaart in de galerij.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(DISPUUT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  events       Event[]
  albums       PhotoAlbum[]
  photos       Photo[]
}

model Member {
  id          String   @id @default(cuid())
  name        String
  title       String
  bio         String
  memberSince Int?
  boardRole   BoardRole? @unique
  category    MemberCategory?
  imagePath      String?
  pointsChoice   PointsChoice?
  pointsFollowUp String         @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String
  location    String
  startsAt    DateTime
  endsAt      DateTime?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startsAt])
  @@index([createdById])
}

model PhotoAlbum {
  id          String   @id @default(cuid())
  name        String
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  photos      Photo[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
}

model Photo {
  id          String     @id @default(cuid())
  albumId     String
  album       PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  storagePath String
  createdById String?
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([albumId])
  @@index([createdById])
}

model Document {
  id          String   @id @default(cuid())
  title       String
  category    String
  fileName    String
  storagePath String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}
